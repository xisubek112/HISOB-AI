PORT=3000
NODE_ENV=development
GEMINI_API_KEY=

# Database backend: "json" (local fallback) | "supabase" (PostgreSQL)
# If DB_BACKEND=supabase is set without DATABASE_URL, server startup stops safely (no silent JSON fallback).
# If DB_BACKEND is omitted, PostgreSQL is used automatically when DATABASE_URL is configured.
DB_BACKEND=json
DATABASE_URL=
# Isolated disposable database ONLY for integration tests (`npm run test:pg`)
TEST_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL connection pool tuning (Render / Supabase Transaction Pooler)
PG_POOL_MAX=10
PG_SSL=true
PG_SSL_REJECT_UNAUTHORIZED=true
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=8000
PG_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=12000

# Auth & CORS security
SESSION_TTL_DAYS=30
AUTH_RATE_MAX_PER_MIN=25
ALLOWED_ORIGINS=https://hisobot-ai.onrender.com

# Local development only (never enable in production)
ENABLE_DEMO_SEED=false
